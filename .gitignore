# =====================================================================
# github/gitignore — Node.gitignore + Global (Linux, macOS, Windows, VSCode, JetBrains)
# =====================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul / vitest / c8
coverage
*.lcov
.nyc_output

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm / eslint / stylelint cache
.npm
.eslintcache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# Caches and build outputs (Note: dist/ is tracked for bundled GitHub Custom Actions)
.cache
.parcel-cache
.next
out
.nuxt
.output
.temp
.vite/
.turbo

# pnpm
.pnpm-store/

# VSCode / Cursor local overrides
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.cursor/skills/

# JetBrains
.idea/
*.iml

# OS-generated files (macOS, Linux, Windows)
.DS_Store
.AppleDouble
.LSOverride
._*
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Local archives & scratch
*.zip
.scratch/
docs/.vitepress/cache/
docs/.vitepress/dist/

