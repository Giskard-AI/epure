  "cards": [
    {
      "dot": "amber",
      "title": "1. Mandatory Human Gates (4)",
      "items": [
        "Gate 1: /epure plan & Grill answers by a write+ contributor",
        "Gate 2: /epure approve signs the immutable spec_sha mandate",
        "Gate 3: Human squash-merge of feature/* -> dev (Agent App blocked)",
        "Gate 4: Manual release-promote workflow (dev -> main fast-forward)"
      ]
    },
    {
      "dot": "cyan",
      "title": "2. Mandatory Automated Steps",
      "items": [
        "Generate GLOSSARY.md, ADRs, Spec & DAG tickets on plan/*",
        "Secretless sandbox TDD (tsc + vitest) on task/* branches",
        "Trusted dev multi-agent review + AI semantic squash into feature/*"
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Optional & Conditional Steps",
      "items": [
        "Conditional UI: DESIGN.md, user-advocate & impeccable-gate when UI exists",
        "Optional: /prototype detour, isolated Pages preview, /epure to-spec, status, cancel",
        "Conditional escalation: needs-human on sensitive paths or >3 fix attempts"
      ]
    }
