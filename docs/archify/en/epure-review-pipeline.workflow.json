      "type": "security",
      "label": "GitHub Checks",
      "sublabel": "ai-review + impeccable",
      "tag": "SHA bound",
      "width": 132
    },
    {
      "id": "auto_fix",
      "lane": "remediation",
      "col": 3,
      "type": "messagebus",
      "label": "Targeted Fix",
      "sublabel": "retry failed agents",
      "tag": "attempt 1..3",
      "width": 132
    },
    {
      "id": "escalate_human",
      "lane": "remediation",
      "col": 5,
      "type": "security",
      "label": "Needs Human",
      "sublabel": ">3 tries / >1 Phase 2",
      "tag": "/epure continue",
      "width": 132
    }
  ],
  "edges": [
    { "id": "pr-to-roster", "from": "pr_opened", "to": "select_roster", "label": "async CI ok", "variant": "emphasis" },
    { "id": "roster-to-review", "from": "select_roster", "to": "agent_review", "label": "max 4 agents", "variant": "default" },
    { "id": "review-to-tools", "from": "agent_review", "to": "readonly_tools", "label": "inspect repo", "variant": "dashed" },
    { "id": "review-to-checks", "from": "agent_review", "to": "publish_checks", "label": "verdicts", "variant": "emphasis" },
    { "id": "checks-to-squash", "from": "publish_checks", "to": "semantic_squash", "label": "0 must_fix", "variant": "emphasis", "fromSide": "top", "toSide": "left" },
    { "id": "squash-to-merge", "from": "semantic_squash", "to": "branch_merged", "label": "converged", "variant": "security" },
    { "id": "checks-to-autofix", "from": "publish_checks", "to": "auto_fix", "label": "must_fix found", "variant": "security", "role": "error" },
    { "id": "autofix-to-review", "from": "auto_fix", "to": "agent_review", "label": "re-review", "variant": "dashed", "role": "return" },
    { "id": "autofix-to-escalate", "from": "auto_fix", "to": "escalate_human", "label": ">3 attempts", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Stage 1: Incremental Write Tools & 2-Phase Kernel Sandbox",
      "items": [
        "Incremental tools write_repo_file, patch_repo_file, delete_repo_file + chunked fallback",
        "Inter-ticket integrity guard snapshots untouched files and reverts unauthorized edits",
        "2-phase kernel sandbox (bwrap/landrun --unshare-net + rtk) strips all secrets during tests"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stage 2: Async PR Checks & Stage 3: Trusted dev Review",
      "items": [
        "Opens task/* -> feature/* PR and exits 0 in waiting_ticket_ci while ci.yml, epure-check & impeccable-gate run",
        "Loads .cursor/agents/*.md strictly from dev (<=4 specialists + spec-parity) with read-only tools",
        "Rounds 1..3 re-run only failed reviewers; AI Semantic Squash synthesizes Conventional Commit"
      ]
    },
    {
      "dot": "amber",
      "title": "Zero-Context EpicConvergenceAudit & Phase 2 Remediation",
      "items": [
        "Audits the combined feature/*..dev diff against docs/specs/* and sub-issue requirements",
        "If gaps remain, automatically creates up to 3 Phase 2 remediation sub-issues in the DAG",
        "Escalates to needs-human after >3 fix attempts or >1 remediation phase; resumed via /epure continue"
      ]
    }
  ]
}
