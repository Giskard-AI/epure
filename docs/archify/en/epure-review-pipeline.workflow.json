    { "id": "sandbox_tools", "label": "Read-Only Inspection & GitHub Checks" },
    { "id": "remediation", "label": "Bounded Remediation & Phase 2 Escalation", "variant": "exception" }
  ],
  "phases": [
    { "id": "select_phase", "label": "1. Stage 1 & 2 Checks", "fromCol": 0, "toCol": 1 },
    { "id": "inspect_phase", "label": "2. Stage 3 Review", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "merge_phase", "label": "3. Squash & Convergence", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "pr_opened",
    "select_roster",
    "agent_review",
    "publish_checks",
    "semantic_squash",
    "branch_merged"
  ],
  "nodes": [
    {
      "id": "pr_opened",
      "lane": "pr_target",
      "col": 0,
      "type": "frontend",
      "label": "Stage 1: Kernel TDD",
      "sublabel": "bwrap/landrun + rtk",
      "tag": "write/patch_repo_file",
      "width": 132
    },
    {
      "id": "semantic_squash",
      "lane": "pr_target",
      "col": 4,
      "type": "backend",
      "label": "Squash & Audit",
      "sublabel": "EpicConvergenceAudit",
      "tag": "Phase 2 if gap",
      "width": 132
    },
    {
      "id": "branch_merged",
      "lane": "pr_target",
      "col": 5,
      "type": "security",
      "label": "Ruleset Merge",
      "sublabel": "feature/* -> dev PR",
      "tag": "squash-only",
      "width": 132
    },
    {
      "id": "select_roster",
      "lane": "roster_engine",
      "col": 1,
      "type": "security",
      "label": "Stage 2 & Roster",
      "sublabel": "waiting_ticket_ci -> dev",
      "tag": "from dev only",
      "width": 132
    },
    {
      "id": "agent_review",
      "lane": "roster_engine",
      "col": 2,
      "type": "backend",
      "label": "Stage 3: Review",
      "sublabel": "spec-parity + domain",
      "tag": "XML wrapped",
      "width": 132
    },
    {
      "id": "readonly_tools",
      "lane": "sandbox_tools",
      "col": 2,
      "type": "database",
      "label": "Read-Only Tools",
      "sublabel": "read_file, search_code",
      "tag": "no write access",
      "width": 132
    },
    {
      "id": "publish_checks",
      "lane": "sandbox_tools",
