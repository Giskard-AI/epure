{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "EPURE 3-Stage Verification, Multi-Agent Review & Epic Convergence Pipeline",
    "subtitle": "Stage 1 kernel sandbox, Stage 2 async CI checks, Stage 3 trusted dev roster & AI squash, plus EpicConvergenceAudit",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/public/diagrams/en/epure-review-pipeline.html"
  },
  "lanes": [
