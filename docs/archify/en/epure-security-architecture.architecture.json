{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "EPURE Security & Trust Boundaries Architecture",
    "subtitle": "Dual GitHub Apps, 2-Phase Kernel Sandbox, Multi-Provider LLMClient, SSRF-Safe Web Tools & Environment Isolation",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/public/diagrams/en/epure-security-architecture.html"
  },
  "layout": {
    "mode": "grid",
    "origin": [48, 84],
    "cols": 4,
    "gapX": 108,
    "gapY": 92,
    "cellW": 148,
    "cellH": 64
  },
  "components": [
    {
      "id": "github_events",
      "type": "external",
      "label": "GitHub Events",
      "sublabel": "Issues & PRs",
      "tag": "untrusted input",
      "row": 0,
      "col": 0
    },
    {
      "id": "cas_state_ref",
      "type": "database",
      "label": "Git Ref CAS",
      "sublabel": "refs/epure/state/*",
      "tag": "spec_sha signed",
      "row": 1,
      "col": 0
    },
    {
      "id": "command_gate",
      "type": "security",
      "label": "Job 1: Auth Gate",
      "sublabel": "authorize-command",
      "tag": "0 App/LLM secrets",
      "row": 0,
      "col": 1
    },
    {
      "id": "orchestrator",
      "type": "backend",
      "label": "Orchestrator",
      "sublabel": "Job 2: env <llm-env>",
      "tag": "issue-N lock",
      "row": 1,
      "col": 1
    },
    {
      "id": "ifixai_audit",
      "type": "security",
      "label": "iFixAi Audit",
      "sublabel": "trajectory gate",
      "tag": "deterministic",
      "row": 2,
      "col": 1
    },
    {
      "id": "llm_sidecar",
      "type": "cloud",
      "label": "Multi-Provider LLM",
      "sublabel": "Gemini/OpenAI/Anthropic",
      "tag": "env: <llm-env>",
      "row": 0,
      "col": 2
    },
    {
      "id": "trusted_reviewers",
      "type": "security",
      "label": "dev Roster",
      "sublabel": "XML diff & web guards",
      "tag": "OWASP LLM01",
      "row": 1,
      "col": 2
    },
    {
      "id": "agent_app_pub",
      "type": "security",
      "label": "Agent App",
      "sublabel": "plan / task / feature",
      "tag": "ephemeral JWT",
      "row": 2,
      "col": 2
    },
    {
      "id": "secretless_sandbox",
      "type": "backend",
      "label": "2-Phase Sandbox",
      "sublabel": "bwrap/landrun + rtk",
      "tag": "--unshare-net",
      "row": 1,
      "col": 3
    },
    {
      "id": "release_app_pub",
      "type": "security",
      "label": "Release App",
      "sublabel": "dev -> main + vX.Y.Z",
      "tag": "env: release",
      "row": 2,
      "col": 3
    }
  ],
  "boundaries": [
    {
      "kind": "region",
      "label": "EPURE Trusted Control Plane (env: <llm-env>)",
      "wraps": [
        "command_gate",
        "orchestrator",
        "ifixai_audit",
        "llm_sidecar",
        "trusted_reviewers",
        "agent_app_pub"
      ]
    },
    {
      "kind": "security-group",
      "label": "2-Phase Kernel Sandbox (0 Secrets)",
      "wraps": ["secretless_sandbox"]
    }
  ],
  "connections": [
    { "id": "evt-to-gate", "from": "github_events", "to": "command_gate", "label": "webhook", "variant": "security" },
    { "id": "gate-to-orch", "from": "command_gate", "to": "orchestrator", "label": "write+", "variant": "emphasis" },
    { "id": "orch-to-state", "from": "orchestrator", "to": "cas_state_ref", "label": "CAS ref", "variant": "default" },
    { "id": "orch-to-llm", "from": "orchestrator", "to": "llm_sidecar", "label": "JSON", "variant": "default" },
    { "id": "orch-to-review", "from": "orchestrator", "to": "trusted_reviewers", "label": "from dev", "variant": "emphasis" },
    { "id": "review-to-sandbox", "from": "trusted_reviewers", "to": "secretless_sandbox", "label": "0 secrets", "variant": "security" },
    { "id": "orch-to-ifixai", "from": "orchestrator", "to": "ifixai_audit", "label": "trace", "variant": "dashed" },
    { "id": "ifixai-to-agent-pub", "from": "ifixai_audit", "to": "agent_app_pub", "label": "publish", "variant": "security" },
    { "id": "agent-to-release", "from": "agent_app_pub", "to": "release_app_pub", "label": "human gate", "variant": "dashed" }
  ],
  "cards": [
    {
      "dot": "rose",
      "title": "Dual-App Separation & GitHub Environment Scoping",
      "items": [
        "Job 1 authorize-command runs with 0 secrets; Job 2 runs inside isolated GitHub Environment <llm-env>",
        "Agent App writes only to plan/*, task/*, and feature/* (blocked from merging to dev or pushing to main)",
        "Release App runs exclusively in environment: release as sole Bypass Actor on main and v* tags"
      ]
    },
    {
      "dot": "cyan",
      "title": "Ubuntu 26.04 2-Phase Kernel Sandbox & Multi-Provider LLM",
      "items": [
        "Multi-Provider LLMClient supports Gemini, OpenAI, Azure OpenAI, and Anthropic with credential scrubbing",
        "Phase A dependency install (controlled net, 0 secrets) -> Phase B tests in bwrap/landrun --unshare-net + rtk",
        "Read-only bind mounts protect .git, .github, and .cursor inside the sandbox"
      ]
    },
    {
      "dot": "emerald",
      "title": "Prompt-Injection Defense & SSRF-Safe Web Tools",
      "items": [
        "Reviewer prompts (.cursor/agents/*.md) load strictly from dev; diffs wrap in <untrusted_pr_diff>",
        "Read-only web_search & web_fetch block RFC1918/loopback/link-local/metadata IPs against SSRF",
        "Fetched web pages are sanitized and wrapped inside <untrusted_web_content> XML boundaries"
      ]
    }
  ]
}
