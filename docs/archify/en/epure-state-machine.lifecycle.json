{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "EPURE Issue State Machine (CAS Git Ref: refs/epure/state/<issue>)",
    "subtitle": "Command-driven phases, async CI substates, EpicConvergenceAudit Phase 2, and /epure continue resumption",
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/public/diagrams/en/epure-state-machine.html"
  },
  "mainPath": [
    "grilling",
    "spec",
    "tickets",
    "implementation",
    "completed"
  ],
  "states": [
    {
      "id": "grilling",
      "type": "start",
      "label": "Grilling",
      "sublabel": "/epure plan + replies",
      "tag": "phase: grilling",
      "step": "01"
    },
    {
      "id": "spec",
      "type": "decision",
      "label": "Spec Draft",
      "sublabel": "/epure to-spec on plan/*",
      "tag": "GLOSSARY + ADR + spec",
      "step": "02"
    },
    {
      "id": "tickets",
      "type": "waiting",
      "label": "Tickets DAG",
      "sublabel": "/epure to-tickets",
      "tag": "sub_issues + blocked_by",
      "step": "03"
    },
    {
      "id": "implementation",
      "type": "active",
      "label": "Implementation",
      "sublabel": "plan/* -> feature/* + CI",
      "tag": "spec_sha + sync + Phase 2",
      "step": "04"
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Completed",
      "sublabel": "feature/* -> dev PR",
      "tag": "ready for merge",
      "step": "05"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Suspended / Failed",
      "sublabel": "needs-human escalation",
      "tag": "/epure continue"
    },
    {
      "id": "cancelled",
      "type": "neutral",
      "label": "Cancelled",
      "sublabel": "/epure cancel",
      "tag": "terminal"
    }
  ],
  "transitions": [
    { "id": "grill-to-spec", "from": "grilling", "to": "spec", "label": "to-spec" },
    { "id": "spec-to-grill", "from": "spec", "to": "grilling", "label": "refine" },
    { "id": "spec-to-tickets", "from": "spec", "to": "tickets", "label": "to-tickets" },
    { "id": "tickets-to-impl", "from": "tickets", "to": "implementation", "label": "approve", "variant": "security" },
    { "id": "impl-to-completed", "from": "implementation", "to": "completed", "label": "audit pass", "variant": "emphasis" },
    { "id": "impl-to-failed", "from": "implementation", "to": "failed", "label": "suspend", "variant": "security" },
    { "id": "failed-to-impl", "from": "failed", "to": "implementation", "label": "continue", "variant": "emphasis" },
    { "id": "tickets-to-cancelled", "from": "tickets", "to": "cancelled", "label": "cancel" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Command-Driven Phases & CAS Ref",
      "items": [
        "State lives in refs/epure/state/<issue> via atomic git update-ref CAS",
        "/epure plan + implicit replies -> /epure to-spec (GLOSSARY.md + ADR + docs/specs/* on plan/*)",
        "/epure to-tickets materializes native GitHub sub_issues & blocked_by edges"
      ]
    },
    {
      "dot": "amber",
      "title": "Approve, Async CI Substates & Convergence",
      "items": [
        "/epure approve integrates plan/* -> feature/* directly and locks spec_sha",
        "Tracks substates implementing, waiting_ticket_ci, and waiting_feature_ci",
        "Supports /epure sync (3-way dev merge) and EpicConvergenceAudit Phase 2 remediation"
      ]
    },
    {
      "dot": "emerald",
      "title": "Suspended Recovery & Cancellation",
      "items": [
        "Escalations or >3 failed attempts enter failed (suspended / needs-human)",
        "/epure continue resumes idempotently from the active DAG ticket or CI state",
        "/epure cancel halts new runs while preserving branches and audit traces"
      ]
    }
  ]
}
