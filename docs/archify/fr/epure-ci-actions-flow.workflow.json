  "cards": [
    {
      "dot": "cyan",
      "title": "Triggers GitHub, Commandes & Split d'Auth 2-Jobs",
      "items": [
        "Triggers : issue_comment, check_suite / workflow_run, pull_request, workflow_dispatch",
        "Commandes : /epure plan, réponses Grill/Spec, /epure to-spec, to-tickets, approve, continue, sync, status, cancel",
        "epure-issue-command.yml sépare Job 1 authorize-command (0 secret) et Job 2 orchestrate-command (env: <llm-env>)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Stage 1 Sandbox Noyau & Stage 2 CI Événementielle",
      "items": [
        "Stage 1 : sandbox Ubuntu 26.04 à 2 phases (bwrap/landrun --unshare-net + rtk) & write/patch/delete_repo_file",
        "Stage 2 : ouvre la PR et quitte (code 0) en waiting_ticket_ci / waiting_feature_ci pendant les checks externes",
        "Exécute ci.yml, epure-check.yml, pr-title.yml & actions/impeccable ; réveillé par check_suite.completed / workflow_run.completed"
      ]
    },
    {
      "dot": "amber",
      "title": "Stage 3 Revue, EpicConvergenceAudit & Release",
      "items": [
        "Stage 3 : charge le roster de confiance depuis dev (<=4 spécialistes) et exécute le Squash Sémantique IA",
        "EpicConvergenceAudit audite le diff global feature/*..dev face à la spec et crée une Phase 2 si incomplet",
        "release.yml s'exécute dans l'environnement isolé release pour promouvoir dev -> main et signer vX.Y.Z"
      ]
    }
  ]
