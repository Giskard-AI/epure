    { "id": "ui-design-to-impeccable", "from": "ui_design_gate", "to": "ui_impeccable_gate", "label": "tokens", "variant": "dashed" },
    { "id": "impeccable-to-review", "from": "ui_impeccable_gate", "to": "review_squash", "label": "check UI", "variant": "dashed", "fromSide": "top", "toSide": "bottom" },
    { "id": "opt-to-ui-design", "from": "opt_commands", "to": "ui_design_gate", "label": "prototype", "variant": "dashed", "role": "branch" },
    { "id": "impeccable-to-escalation", "from": "ui_impeccable_gate", "to": "needs_human", "label": ">3 essais", "variant": "security", "role": "error" }
