{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Flux Global d'une Issue & PR EPURE (Portes Humaines, Obligatoire & Conditionnel)",
    "subtitle": "Phases pilotées (/epure plan -> to-spec -> to-tickets -> approve), sandbox 2-phases, CI asynchrone & EpicConvergenceAudit",
    "legend": {
      "entries": {
        "frontend": { "label": "Porte UI / Design" },
        "backend": { "label": "Orchestrateur EPURE" },
        "security": { "label": "Porte Humaine / Gouvernance" },
        "external": { "label": "Contrôle & Pilotage" }
      }
    },
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/public/diagrams/fr/epure-issue-flow.html"
  },
  "lanes": [
    { "id": "human_mandatory", "label": "Mainteneur — 4 Portes Humaines Obligatoires" },
    { "id": "auto_mandatory", "label": "Orchestrateur EPURE — Pipeline Obligatoire" },
    { "id": "ui_conditional", "label": "Porte Conditionnelle UI & Preview" },
    { "id": "optional_escalation", "label": "Contrôles de Pilotage & Escalade Humaine", "variant": "exception" }
  ],
  "phases": [
    { "id": "clarify_phase", "label": "1. Grill, Spec & DAG", "fromCol": 0, "toCol": 1 },
    { "id": "approve_exec", "label": "2. Mandat & TDD 3-Stages", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "integrate_release", "label": "3. Convergence & Release", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": [
    "gate1_plan",
    "gen_blueprint",
    "gate2_approve",
    "tdd_sandbox",
    "review_squash",
    "final_feature_pr",
    "gate3_merge_dev",
    "gate4_release"
  ],
  "nodes": [
    {
      "id": "gate1_plan",
      "lane": "human_mandatory",
      "col": 0,
      "type": "security",
      "label": "Jalon 1: /epure plan",
      "sublabel": "Grill -> to-spec",
      "tag": "porte humaine",
      "width": 132
    },
    {
      "id": "gate2_approve",
      "lane": "human_mandatory",
      "col": 2,
      "type": "security",
      "label": "Jalon 2: Approuver",
      "sublabel": "plan/* -> feature/*",
      "tag": "verrou spec_sha",
      "width": 132
    },
    {
      "id": "gate3_merge_dev",
      "lane": "human_mandatory",
      "col": 4,
      "type": "security",
      "label": "Jalon 3: Merge dev",
      "sublabel": "merge PR humain",
      "tag": "porte humaine",
      "width": 132
    },
    {
      "id": "gate4_release",
      "lane": "human_mandatory",
      "col": 5,
      "type": "security",
      "label": "Jalon 4: Release",
      "sublabel": "dev -> main",
      "tag": "porte humaine",
      "width": 132
    },
    {
      "id": "gen_blueprint",
      "lane": "auto_mandatory",
      "col": 1,
      "type": "backend",
      "label": "Spec & Tickets",
      "sublabel": "sub_issues + blocked_by",
      "tag": "to-tickets",
      "width": 132
