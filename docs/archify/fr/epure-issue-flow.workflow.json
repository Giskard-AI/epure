      "tag": "Phase 2 si écart",
      "width": 132
    },
    {
      "id": "final_feature_pr",
      "lane": "auto_mandatory",
      "col": 4,
      "type": "backend",
      "label": "PR de Synthèse",
      "sublabel": "feature/* -> dev",
      "tag": "auto requis",
      "width": 132
    },
    {
      "id": "ui_design_gate",
      "lane": "ui_conditional",
      "col": 1,
      "type": "frontend",
      "label": "Porte DESIGN.md",
      "sublabel": "user-advocate",
      "tag": "si UI",
      "width": 132
    },
    {
      "id": "ui_impeccable_gate",
      "lane": "ui_conditional",
      "col": 3,
      "type": "frontend",
      "label": "Porte Impeccable",
      "sublabel": "WCAG AA + tokens",
      "tag": "si UI",
      "width": 132
    },
    {
      "id": "opt_commands",
      "lane": "optional_escalation",
      "col": 0,
      "type": "external",
      "label": "Commandes Pilotage",
      "sublabel": "continue, sync, cancel",
      "tag": "to-spec / status",
