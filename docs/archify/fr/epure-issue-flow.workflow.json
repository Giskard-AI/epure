      "id": "needs_human",
      "lane": "optional_escalation",
      "col": 3,
      "type": "security",
      "label": "Escalade Humaine",
      "sublabel": "suspendu -> continue",
      "tag": "conditionnel",
      "width": 132
    }
  ],
  "edges": [
    { "id": "plan-to-blueprint", "from": "gate1_plan", "to": "gen_blueprint", "label": "to-spec", "variant": "emphasis" },
    { "id": "blueprint-to-approve", "from": "gen_blueprint", "to": "gate2_approve", "label": "to-tickets", "variant": "security", "fromSide": "top", "toSide": "left" },
    { "id": "approve-to-tdd", "from": "gate2_approve", "to": "tdd_sandbox", "label": "plan->feature", "variant": "emphasis" },
    { "id": "tdd-to-review", "from": "tdd_sandbox", "to": "review_squash", "label": "CI async", "variant": "default" },
    { "id": "review-to-final-pr", "from": "review_squash", "to": "final_feature_pr", "label": "convergé", "variant": "emphasis" },
    { "id": "final-pr-to-gate3", "from": "final_feature_pr", "to": "gate3_merge_dev", "label": "vérifié", "variant": "security" },
    { "id": "gate3-to-gate4", "from": "gate3_merge_dev", "to": "gate4_release", "label": "promouvoir", "variant": "emphasis" },
    { "id": "blueprint-to-ui-design", "from": "gen_blueprint", "to": "ui_design_gate", "label": "si UI", "variant": "dashed", "role": "branch" },
    { "id": "ui-design-to-impeccable", "from": "ui_design_gate", "to": "ui_impeccable_gate", "label": "tokens", "variant": "dashed" },
    { "id": "impeccable-to-review", "from": "ui_impeccable_gate", "to": "review_squash", "label": "check UI", "variant": "dashed", "fromSide": "top", "toSide": "bottom" },
    { "id": "opt-to-ui-design", "from": "opt_commands", "to": "ui_design_gate", "label": "pilotage", "variant": "dashed", "role": "branch" },
    { "id": "impeccable-to-escalation", "from": "ui_impeccable_gate", "to": "needs_human", "label": ">3 essais", "variant": "security", "role": "error" }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "1. Portes Humaines Obligatoires (4)",
      "items": [
        "Jalon 1 : /epure plan -> réponses Grill -> /epure to-spec -> /epure to-tickets",
        "Jalon 2 : /epure approve fusionne plan/* -> feature/* directement et signe spec_sha",
        "Jalon 3 : Squash-merge humain de feature/* -> dev (Agent App interdit)",
        "Jalon 4 : Dispatch manuel release.yml (fast-forward dev -> main dans env: release)"
      ]
    },
    {
      "dot": "cyan",
      "title": "2. Pipeline Automatisé Obligatoire",
      "items": [
        "Génère GLOSSARY.md, ADRs & Spec sur plan/* + sub_issues & blocked_by natifs GitHub",
        "TDD en sandbox noyau 2-phases (bwrap/landrun + rtk) + attente CI événementielle",
        "Stage 3 revue dev + squash sémantique IA + EpicConvergenceAudit avant PR feature/* -> dev"
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Pilotage, Sync & Reprise d'Escalade",
      "items": [
        "Conditionnel UI : DESIGN.md, user-advocate & impeccable-gate si fichiers UI touchés",
        "Commandes : /epure continue (reprise DAG/CI suspendu), /epure sync (merge 3-voies dev), status, cancel",
        "Escalade : passe en état suspendu needs-human après >3 essais ou chemin sensible"
      ]
    }
  ]
}
