  "cards": [
    {
      "dot": "amber",
      "title": "1. Portes Humaines Obligatoires (4)",
      "items": [
        "Jalon 1 : /epure plan & réponses au Grill par un contributeur write+",
        "Jalon 2 : /epure approve signe le mandat immuable spec_sha",
        "Jalon 3 : Squash-merge humain de feature/* -> dev (Agent App interdit)",
        "Jalon 4 : Workflow manuel release-promote (fast-forward dev -> main)"
      ]
    },
    {
      "dot": "cyan",
      "title": "2. Étapes Automatisées Obligatoires",
      "items": [
        "Génération GLOSSARY.md, ADRs, Spec & DAG de tickets sur plan/*",
        "Boucle TDD en sandbox sans secret (tsc + vitest) sur task/*",
        "Revue multi-agents depuis dev + squash sémantique IA vers feature/*"
      ]
    },
    {
      "dot": "emerald",
      "title": "3. Étapes Facultatives & Conditionnelles",
      "items": [
        "Conditionnel UI : DESIGN.md, user-advocate & impeccable-gate si UI présente",
        "Facultatif : détour /prototype, preview Pages isolée, /epure to-spec, status, cancel",
        "Escalade : needs-human sur chemin sensible ou après 3 échecs de correction"
      ]
    }
  ]
