      "label": "Sandbox 2-Phases",
      "sublabel": "bwrap/landrun + rtk",
      "tag": "pause CI async",
      "width": 132
    },
    {
      "id": "review_squash",
      "lane": "auto_mandatory",
      "col": 3,
      "type": "backend",
      "label": "Stage 3 & Audit",
