  "cards": [
    {
      "dot": "rose",
      "title": "Séparation de Privilèges à 2 GitHub Apps",
      "items": [
        "L'Agent App (<owner>-epure-agent) n'écrit que sur plan/*, task/* et feature/*",
        "Interdiction matérielle d'auto-merge applicatif sur dev ou de push sur main",
        "La Release App (<owner>-epure-release) est le seul Bypass Actor sur main et v*"
      ]
    },
    {
      "dot": "cyan",
      "title": "Sandbox Sans Secret & Proxy LLM",
      "items": [
        "Les sous-processus de test/build tournent sans LLM_API_KEY ni clés PEM",
        "Politique fail-closed : arrêt immédiat si l'isolation des secrets fait défaut",
        "Audit déterministe de trajectoire iFixAi avant chaque opération privilégiée"
      ]
    },
    {
      "dot": "emerald",
      "title": "Immunité Prompt-Injection (OWASP LLM01)",
      "items": [
        "Prompts des reviewers (.cursor/agents/*.md) chargés exclusivement depuis dev",
        "Diffs et commentaires non fiables encapsulés dans <untrusted_pr_diff>",
        "Toute modification de .cursor/agents/** ou workflows bloque l'auto-merge"
      ]
    }
