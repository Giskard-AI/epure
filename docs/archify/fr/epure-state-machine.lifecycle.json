{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Machine à États d'une Issue EPURE (Ref Git CAS : refs/epure/state/<issue>)",
    "subtitle": "Phases pilotées par commandes, sous-états CI asynchrones, EpicConvergenceAudit Phase 2 et reprise /epure continue",
    "legend": {
      "entries": {
        "start": { "label": "état initial" },
        "active": { "label": "en cours" },
        "waiting": { "label": "en attente" },
        "decision": { "label": "décision" },
        "success": { "label": "succès" },
        "failure": { "label": "suspendu / escalade" },
        "neutral": { "label": "annulé" }
      }
    },
    "visual_preset": "blueprint",
    "quality_profile": "showcase",
    "output": "docs/public/diagrams/fr/epure-state-machine.html"
  },
  "mainPath": [
    "grilling",
    "spec",
    "tickets",
    "implementation",
    "completed"
  ],
  "states": [
    {
      "id": "grilling",
      "type": "start",
      "label": "Entretien Grill",
      "sublabel": "/epure plan + réponses",
      "tag": "phase: grilling",
      "step": "01"
    },
    {
      "id": "spec",
      "type": "decision",
      "label": "Brouillon Spec",
      "sublabel": "/epure to-spec sur plan/*",
      "tag": "GLOSSARY + ADR + spec",
      "step": "02"
    },
    {
      "id": "tickets",
      "type": "waiting",
      "label": "DAG de Tickets",
      "sublabel": "/epure to-tickets",
      "tag": "sub_issues + blocked_by",
      "step": "03"
    },
    {
      "id": "implementation",
      "type": "active",
      "label": "Implémentation",
      "sublabel": "plan/* -> feature/* + CI",
      "tag": "spec_sha + sync + Phase 2",
      "step": "04"
    },
    {
      "id": "completed",
      "type": "success",
      "label": "Terminé",
      "sublabel": "PR feature/* -> dev",
      "tag": "prêt à merger",
      "step": "05"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "Suspendu / Escalade",
      "sublabel": "escalade needs-human",
      "tag": "/epure continue"
    },
    {
      "id": "cancelled",
      "type": "neutral",
      "label": "Annulé",
      "sublabel": "/epure cancel",
      "tag": "terminal"
    }
  ],
  "transitions": [
    { "id": "grill-to-spec", "from": "grilling", "to": "spec", "label": "to-spec" },
    { "id": "spec-to-grill", "from": "spec", "to": "grilling", "label": "affiner" },
    { "id": "spec-to-tickets", "from": "spec", "to": "tickets", "label": "to-tickets" },
    { "id": "tickets-to-impl", "from": "tickets", "to": "implementation", "label": "approve", "variant": "security" },
    { "id": "impl-to-completed", "from": "implementation", "to": "completed", "label": "audit ok", "variant": "emphasis" },
    { "id": "impl-to-failed", "from": "implementation", "to": "failed", "label": "suspendre", "variant": "security" },
    { "id": "failed-to-impl", "from": "failed", "to": "implementation", "label": "continue", "variant": "emphasis" },
    { "id": "tickets-to-cancelled", "from": "tickets", "to": "cancelled", "label": "annuler" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Phases Pilotées par Commandes & Ref CAS",
      "items": [
        "État stocké dans refs/epure/state/<issue> par git update-ref atomique CAS",
        "/epure plan + réponses implicites -> /epure to-spec (GLOSSARY.md + ADR + docs/specs/* sur plan/*)",
        "/epure to-tickets matérialise les relations natives GitHub sub_issues et blocked_by"
      ]
    },
    {
      "dot": "amber",
      "title": "Approbation, Sous-États CI Async & Convergence",
      "items": [
        "/epure approve intègre plan/* -> feature/* directement et verrouille spec_sha",
        "Suit les sous-états implementing, waiting_ticket_ci et waiting_feature_ci",
        "Supporte /epure sync (merge 3-voies dev) et la Phase 2 d'EpicConvergenceAudit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reprise après Suspension & Annulation",
      "items": [
        "Une escalade ou >3 échecs place l'issue en état failed (suspended / needs-human)",
        "/epure continue reprend de manière idempotente au ticket ou check CI actif",
        "/epure cancel fige l'exécution tout en préservant les branches et traces d'audit"
      ]
    }
  ]
}
