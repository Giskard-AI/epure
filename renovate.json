{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests",
    "security:openssf-scorecard",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "schedule": [
    "before 6am on monday"
  ],
  "timezone": "UTC",
  "labels": [
    "dependencies",
    "renovate"
  ],
  "semanticCommits": "enabled",
  "commitMessageAction": "bump",
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "platformAutomerge": false,
  "npmrc": "ignore-scripts=true\n",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "minimumReleaseAge": "0 days",
    "automerge": false
  },
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Supply-chain protection: never merge or propose day-1 releases (default 3-day quarantine cooldown)",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Expedite verified security vulnerability patches while keeping PR review trace",
      "matchCategories": [
        "security"
      ],
      "minimumReleaseAge": "0 days",
      "automerge": false
    },
    {
      "description": "Actions and container image cooldown (7 days) + automatic PR update for digests & versions",
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "docker-compose"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Group GitHub Actions digest & version updates",
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Require explicit maintainer review on major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": false
    },
    {
      "description": "npm patch cooldown (hijacked publish window protection)",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "npm minor cooldown",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "npm major cooldown",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "14 days",
      "automerge": false
    },
    {
      "description": "Group npm minor, patch, and pin updates",
      "groupName": "npm-minor-and-patch",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ]
    }
  ]
}
